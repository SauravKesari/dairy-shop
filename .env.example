# Firebase web app config: Firebase console -> Project settings -> Your apps -> Web app.
# Copy this file to .env.local and fill in the values (.env.local is git-ignored).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Staff log in with mobile + PIN; the mobile is mapped to <mobile>@<this domain> in Firebase Auth.
# Don't change it after staff accounts have been created.
VITE_AUTH_EMAIL_DOMAIN="dairyshop.local"

# Days of sales / stock movements / audit logs loaded live (keeps Firestore reads in the free tier).
VITE_HISTORY_DAYS="90"

# "true" to use local Firebase emulators (firebase emulators:start) instead of the real project.
VITE_USE_EMULATOR="false"
